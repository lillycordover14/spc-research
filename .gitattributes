# Originals under raw/ go to Git LFS so the repo stays fast. Text extracted into sources/ is what agents read.
themes/*/raw/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
themes/*/raw/**/*.docx filter=lfs diff=lfs merge=lfs -text
themes/*/raw/**/*.pptx filter=lfs diff=lfs merge=lfs -text
themes/*/raw/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
themes/*/raw/**/*.zip  filter=lfs diff=lfs merge=lfs -text
*.sqlite binary
